{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Flowmato 權限：視窗置頂、桌面通知、匯出 .ics 到使用者選擇的位置",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "notification:default",
    "dialog:default",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    }
  ]
}
