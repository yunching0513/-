{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flowmato",
  "mainBinaryName": "flowmato",
  "version": "1.0.0",
  "identifier": "tw.yunching.flowmato",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Flowmato 心流鐘",
        "width": 340,
        "height": 540,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "順應大腦限制的心流專注工具",
    "longDescription": "以蕃茄工作法為核心的專注工具：開始前先卸載腦中牽掛，25 分鐘專注、5 分鐘休息，休息時以呼吸引導讓大腦真正離線，並可疊加三層專注音景。",
    "copyright": "© 2026 吳昀慶 Yun Ching Wu",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "minimumSystemVersion": "13.0"
    },
    "android": {
      "minSdkVersion": 24
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
