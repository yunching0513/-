# ============================================================
# Strata — environment variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# --- AI (optional — users can also bring their own key in /app/settings) ---
# Server-side fallback keys; used when a visitor hasn't pasted their own.
# Get keys at:
#   Anthropic Claude  → https://console.anthropic.com
#   OpenAI            → https://platform.openai.com/api-keys
#   Google Gemini     → https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Persistence (Phase 2) ----------------------------------
# Supabase project credentials. The free tier is enough for
# tens of users. https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing (Phase 2) --------------------------------------
# Stripe keys for usage-based AI billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- App ----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
